# Copy this file to .env and adjust if needed.

# PostgreSQL from `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://stockwatch:stockwatch@localhost:5433/stockwatch?schema=public"
# Separate database that `npm test` migrates and wipes between tests
TEST_DATABASE_URL="postgresql://stockwatch:stockwatch@localhost:5433/stockwatch_test?schema=public"

PORT=3000

# Temporary until Better Auth is wired in: every API request acts as this
# user. `npm run db:seed` creates it.
DEV_USER_ID="demo-user"

# Free key from https://finnhub.io for live prices and the ticker check on new
# watches. If not set, the poller and the ticker check are skipped. Tests ignore it.
FINNHUB_API_KEY=

# SMTP for alert emails. If not set, emails are skipped (alerts still reach the
# live stream at /api/alerts/stream).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ALLOW_INVALID_CERT=false
ALERT_EMAIL_FROM=